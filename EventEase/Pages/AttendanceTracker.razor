@page "/admin/attendance/{eventId:int}"
@using EventEase.Data
@using RegistrationData = EventEase.Data.Registration
@inject EventService EventService
@inject NavigationManager Navigation

<PageTitle>Attendance Tracker - EventEase Admin</PageTitle>

<div class="container-fluid">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
            <li class="breadcrumb-item active">Attendance Tracker</li>
        </ol>
    </nav>

    @if (currentEvent == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col">
                <h1 class="h3 mb-3">
                    <i class="fas fa-clipboard-check me-2 text-primary"></i>
                    Attendance Tracker - @currentEvent.Name
                </h1>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="card-title">Total Registered</h6>
                                <h3 class="mb-0">@registrations.Count</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-users fa-2x opacity-75"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="card-title">Checked In</h6>
                                <h3 class="mb-0">@attendanceRecords.Count</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-check-circle fa-2x opacity-75"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="card-title">Not Arrived</h6>
                                <h3 class="mb-0">@(registrations.Count - attendanceRecords.Count)</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-clock fa-2x opacity-75"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="card-title">Attendance Rate</h6>
                                <h3 class="mb-0">@attendanceRate%</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-chart-pie fa-2x opacity-75"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Attendee Management</h5>
                        <div>
                            <button class="btn btn-success me-2" @onclick="RefreshData">
                                <i class="fas fa-sync-alt me-1"></i>Refresh
                            </button>
                            <button class="btn btn-primary" @onclick="ExportData">
                                <i class="fas fa-download me-1"></i>Export
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (registrations.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Phone</th>
                                            <th>Registration Date</th>
                                            <th>Status</th>
                                            <th>Check-in Time</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var registration in registrations)
                                        {
                                            var attendance = attendanceRecords.FirstOrDefault(a => a.RegistrationId == registration.Id);
                                            <tr class="@(attendance != null ? "table-success" : "")">
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        @if (attendance != null)
                                                        {
                                                            <i class="fas fa-check-circle text-success me-2"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-circle text-muted me-2"></i>
                                                        }
                                                        <strong>@registration.Name</strong>
                                                    </div>
                                                </td>
                                                <td>@registration.Email</td>
                                                <td>@registration.Phone</td>
                                                <td>@registration.RegistrationDate.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(registration.Status)">
                                                        @registration.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (attendance != null)
                                                    {
                                                        <span class="text-success">
                                                            @attendance.CheckInTime.ToString("HH:mm")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Not checked in</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (attendance == null)
                                                    {
                                                        <button class="btn btn-sm btn-success" 
                                                                @onclick="() => CheckInAttendee(registration.Id)">
                                                            <i class="fas fa-check me-1"></i>Check In
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-success">
                                                            <i class="fas fa-check-circle me-1"></i>Checked In
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">No registrations yet</h5>
                                <p class="text-muted">Attendees will appear here once they register for the event.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int EventId { get; set; }
    
    private Event? currentEvent;
    private List<RegistrationData> registrations = new();
    private List<AttendanceRecord> attendanceRecords = new();
    private int attendanceRate => registrations.Count > 0 ? 
        (int)Math.Round((double)attendanceRecords.Count / registrations.Count * 100) : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        currentEvent = await EventService.GetEventByIdAsync(EventId);
        if (currentEvent == null)
        {
            Navigation.NavigateTo("/");
//#nullable disable
            return;
        }

        registrations = await EventService.GetRegistrationsForEventAsync(EventId);
        attendanceRecords = await EventService.GetAttendanceForEventAsync(EventId);
    }

    private async Task CheckInAttendee(int registrationId)
    {
        var success = await EventService.CheckInAttendeeAsync(registrationId);
        if (success)
        {
            await LoadData(); // Refresh data
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        StateHasChanged();
    }

    private async Task ExportData()
    {
        // Implementation for exporting attendance data
        var csvData = GenerateCSVData();
        // You would typically download this as a file
        await Task.CompletedTask;
    }

    private string GenerateCSVData()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Name,Email,Phone,Registration Date,Status,Check-in Time");
        
        foreach (var registration in registrations)
        {
            var attendance = attendanceRecords.FirstOrDefault(a => a.RegistrationId == registration.Id);
            csv.AppendLine($"{registration.Name},{registration.Email},{registration.Phone}," +
                          $"{registration.RegistrationDate:yyyy-MM-dd},{registration.Status}," +
                          $"{(attendance?.CheckInTime.ToString("yyyy-MM-dd HH:mm") ?? "Not checked in")}");
        }
        
        return csv.ToString();
    }

    private string GetStatusBadgeClass(RegistrationStatus status)
    {
        return status switch
        {
            RegistrationStatus.Confirmed => "bg-success",
            RegistrationStatus.Pending => "bg-warning",
            RegistrationStatus.Cancelled => "bg-danger",
            RegistrationStatus.Attended => "bg-primary",
            _ => "bg-secondary"
        };
    }
}