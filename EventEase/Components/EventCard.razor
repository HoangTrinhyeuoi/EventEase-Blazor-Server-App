@using EventEase.Data

<div class="card event-card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Event.Name</h5>
        <div class="event-details mb-3">
            <div class="detail-item">
                <i class="fas fa-calendar-alt me-2 text-primary"></i>
                <span>@Event.Date.ToString("MMMM dd, yyyy")</span>
            </div>
            <div class="detail-item">
                <i class="fas fa-clock me-2 text-primary"></i>
                <span>@Event.Date.ToString("h:mm tt")</span>
            </div>
            <div class="detail-item">
                <i class="fas fa-map-marker-alt me-2 text-primary"></i>
                <span>@Event.Location</span>
            </div>
        </div>

        <p class="card-text flex-grow-1">@Event.Description</p>

        <div class="event-meta">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-secondary">@Event.Category</span>
                <span class="text-success fw-bold">$@Event.Price.ToString("F2")</span>
            </div>

            <div class="progress mb-3" style="height: 6px;">
                <div class="progress-bar"
                     role="progressbar"
                     style="width: @(((double)Event.CurrentAttendees / Event.MaxAttendees) * 100)%">
                </div>
            </div>

            <small class="text-muted">@Event.CurrentAttendees / @Event.MaxAttendees attendees</small>
        </div>

        <div class="mt-3">
            <a href="/event/@Event.Id" class="btn btn-primary me-2">View Details</a>
            <a href="/register/@Event.Id" class="btn btn-outline-primary">Register</a>
        </div>
    </div>
</div>

<style>
    .event-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border: none;
        border-radius: 12px;
    }

    .event-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }

    .detail-item {
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .event-meta {
        border-top: 1px solid #e9ecef;
        padding-top: 1rem;
        margin-top: auto;
    }

    .progress-bar {
        background: linear-gradient(90deg, #007bff, #0056b3);
    }
</style>

@code {
    [Parameter] public Event Event { get; set; } = new();
}